#
# Releases up to 1.x mounted the state directory as /var/lib/ntfy, so ntfy
# kept its databases and attachments next to the agent files, and the
# backup did not include them. Move them into the ntfy-app volume, which is
# now mounted as /var/lib/ntfy and backed up through module-dump-state.
#
# ntfy is stopped while files are moved; 20restart starts it again.
# It runs on every update and does nothing once the files are moved.
#

import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "pypkg"))
import ntfy_backup

state_dir = os.environ["AGENT_STATE_DIR"]
os.chdir(state_dir)
moved = ntfy_backup.move_legacy_data(state_dir)
if moved:
    print(f"Moved {', '.join(moved)} to the {ntfy_backup.DATA_VOLUME} volume", file=sys.stderr)
