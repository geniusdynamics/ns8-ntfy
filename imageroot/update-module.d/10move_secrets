#
# Move secrets that older releases stored with agent.set_env() (in the
# module environment, copied to Redis and readable by every module of the
# node) to state/passwords.env, mode 0600, and remove them from the
# environment. It runs on every update and does nothing once moved.
#
# Release 1.0.0 wrote the string "None" for missing inputs, and later
# releases wrote empty values: both are dropped. Passed to ntfy, a "None"
# Web Push public key would enable Web Push and stop ntfy from starting.
#

import os
import sys

import agent

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "pypkg"))
import ntfy_config

state_dir = os.environ["AGENT_STATE_DIR"]
try:
    environment = agent.read_envfile(os.path.join(state_dir, "environment"))
except FileNotFoundError:
    environment = {}

current = ntfy_config.read_secrets(state_dir)
moved = {key: environment[key] for key in ntfy_config.SECRET_INPUTS.values()
         if key in environment and key not in current}
# write_secrets() also drops empty and "None" values already in the file
ntfy_config.write_secrets(moved, state_dir)

for key in ntfy_config.SECRET_INPUTS.values():
    agent.unset_env(key)
