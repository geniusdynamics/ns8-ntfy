import json
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "..", "pypkg"))
import ntfy_accounts

try:
    result = ntfy_accounts.manage_account(json.load(sys.stdin))
except ntfy_accounts.AccountError as error:
    # Error codes only: CLI output may contain passwords or tokens.
    print(str(error), file=sys.stderr)
    sys.exit(1)
json.dump(result, sys.stdout)
