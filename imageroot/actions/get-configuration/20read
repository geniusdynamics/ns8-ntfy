#
# Read configuration. Secrets (passwords.env, and secret or module-managed
# options of server.yml) are never returned: task results are stored in
# Redis and shown to every NS8 administrator.
#

import json
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "..", "pypkg"))
import ntfy_config

config = {}
config["host"] = os.getenv("TRAEFIK_HOST", "")
config["http2https"] = os.getenv("TRAEFIK_HTTP2HTTPS") == "True"
config["lets_encrypt"] = os.getenv("TRAEFIK_LETS_ENCRYPT") == "True"
if os.path.exists(ntfy_config.CONFIG_PATH):
    content = ntfy_config.read_server_config()
else:
    content = ntfy_config.default_config(config["host"])

config["ios_push"] = bool(ntfy_config.parse_config(content).get("upstream-base-url"))
config["auth_enabled"] = ntfy_config.auth_enabled(content)
config["server_config"] = ntfy_config.editable_config(content)

json.dump(config, fp=sys.stdout)
