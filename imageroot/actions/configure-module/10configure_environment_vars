#
# Write the ntfy configuration: state/config/server.yml for the settings,
# state/passwords.env (mode 0600) for the secrets. Secrets are never stored
# with agent.set_env(): the module environment is copied to Redis, readable
# by every module of the node.
#

import json
import os
import sys

import agent

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "..", "pypkg"))
import ntfy_config

data = json.load(sys.stdin)
host = data.get("host", "")
old_host = os.environ.get("TRAEFIK_HOST", "")

# An instance that was not updated through update-module.d (it should not
# happen) still keeps its NTFY_* settings.
ntfy_config.migrate_legacy_environment(os.environ, old_host or host)
ntfy_config.unset_legacy_environment(agent)

previous = ntfy_config.read_server_config()
server_config = data.get("server_config")
if server_config is None:
    if not os.path.exists(ntfy_config.CONFIG_PATH):
        server_config = ntfy_config.default_config(host)
    else:
        server_config = ntfy_config.editable_config(previous)
        # Follow a host change when base-url still points to the old host
        parsed = ntfy_config.parse_config(server_config)
        if old_host and host != old_host and parsed.get("base-url") == "https://" + old_host:
            parsed["base-url"] = "https://" + host
            server_config = ntfy_config.dump_config(parsed)

content = ntfy_config.merge_configuration(server_config, previous, data.get("ios_push"))
content = ntfy_config.apply_legacy_options(content, data)
ntfy_config.write_server_config(content)

secrets = {key: data[name] for name, key in ntfy_config.SECRET_INPUTS.items() if name in data}
if secrets or not os.path.exists(ntfy_config.secrets_path()):
    ntfy_config.write_secrets(secrets)
for key in ntfy_config.SECRET_INPUTS.values():
    agent.unset_env(key)
