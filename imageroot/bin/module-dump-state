# Prepare a quiet copy before NS8 starts Restic. ntfy is restarted even when
# copying fails, so a failed backup cannot leave the service stopped.
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "pypkg"))
import ntfy_backup

ntfy_backup.make_snapshot(os.environ["AGENT_STATE_DIR"])
